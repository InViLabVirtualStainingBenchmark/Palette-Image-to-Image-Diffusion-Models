Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-rockylinux9

%post
    # 1. Install Python 3.9 and core tools
    dnf -y update && \
    dnf -y install \
        python3.9 python3.9-devel python3-pip git \
        libX11 libXext libXrender mesa-libGL glib2 && \
    dnf clean all

    # Set up Python 3.9
    ln -sf /usr/bin/python3.9 /usr/bin/python
    ln -sf /usr/bin/python3.9 /usr/local/bin/python

    python3.9 -m ensurepip
    python3.9 -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # 2. Install dependencies
    python3.9 -m pip install --no-cache-dir \
        "numpy==1.26.4" \
        "torch==2.1.2" \
        "torchvision==0.16.2" \
        "pandas==2.0.3" \
        "lpips" \
        "tqdm" \
        "scipy" \
        "opencv-python-headless" \
        "clean-fid" \
        "torch-fidelity" \
        "tensorboard" \
        "dominate" \
        "kornia" \
        "scikit-image" \
        --extra-index-url https://download.pytorch.org/whl/cu121

%environment
    export PYTHONUNBUFFERED=1
